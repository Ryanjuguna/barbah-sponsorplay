    {
      "name": "4. PayPal Escrow & Multiparty Orders",
      "item": [
        {
          "name": "Create PayPal Multiparty Escrow Order (Agent 4: Finance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposal_id\": \"{{proposal_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/create-escrow-order",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "create-escrow-order"]
            }
          }
        },
        {
          "name": "Capture PayPal Order into Escrow",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/capture-order/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "capture-order", "{{order_id}}"]
