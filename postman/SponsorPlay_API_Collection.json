              "raw": "{\n  \"brand_name\": \"Safaricom 5G Gaming\",\n  \"corporate_pin\": \"P051234567A\",\n  \"brief\": \"Reaching 10,000 university gamers and community gaming dens in Nairobi and Eldoret.\",\n  \"target_audience\": \"16-25 urban youth\",\n  \"target_reach\": 10000,\n  \"budget_usd\": 769.23,\n  \"preferred_locations\": [\"Nairobi\", \"Eldoret\"]\n}"
