# Copy this file to .env and fill in real values. Never commit the real .env.

# Anthropic Claude (cognitive brain for the agent swarm)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# PayPal Developer Sandbox (developer.paypal.com -> Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# KES conversion rate used for display/pricing
USD_TO_KES_RATE=130.0
